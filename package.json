{
  "name": "k8sight",
  "version": "1.5.3",
  "description": "A native desktop UI for browsing and operating Kubernetes clusters",
  "author": {
    "name": "Praveen Kumar",
    "email": "praveensinghraghav96@gmail.com"
  },
  "license": "MIT",
  "desktopName": "k8sight",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "version:sync": "node scripts/sync-version.mjs",
    "fetch:trivy": "node scripts/fetch-trivy.mjs",
    "fetch:helm": "node scripts/fetch-helm.mjs",
    "postinstall": "node scripts/fix-pty-helper.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "build": "node scripts/write-gke-oauth.mjs && npm run version:sync && cd client && npm run build",
    "start": "node server.js",
    "app": "electron .",
    "app:pack": "npm run fetch:trivy && npm run build && npm run bundle:helpers && electron-builder --dir --mac",
    "app:dist": "npm run fetch:trivy && npm run build && npm run bundle:helpers && electron-builder --mac",
    "dist": "npm run fetch:trivy && npm run build && npm run bundle:helpers && electron-builder --publish never",
    "mcp": "node mcp-stdio.js",
    "bundle:helpers": "node scripts/bundle-token-helpers.mjs"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-eks": "^3.1127.0",
    "@aws-sdk/client-sso": "^3.1127.0",
    "@aws-sdk/client-sso-oidc": "^3.1127.0",
    "@aws-sdk/client-sts": "^3.1127.0",
    "@aws-sdk/credential-providers": "^3.1127.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@kubernetes/client-node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/shared-ini-file-loader": "^4.7.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "concurrently": "^8.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.k8sight.desktop",
    "productName": "k8sight",
    "asar": true,
    "afterPack": "electron/after-pack.cjs",
    "afterSign": "electron/notarize.cjs",
    "afterAllArtifactBuild": "electron/notarize-dmg.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "*.js",
      "gke-oauth.json",
      "lib/**/*",
      "VERSION",
      "package.json",
      "client/dist/**/*",
      "dist-helpers/**/*",
      "!**/*.d.ts",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/{test,tests,__tests__,__mocks__,example,examples,docs,doc,.github,.vscode,.idea}/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "trivy*",
          "helm*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "artifactName": "${productName}-macos.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "format": "ULFO"
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "A desktop UI for browsing and operating Kubernetes clusters",
      "description": "k8sight is a native desktop app for browsing and operating any Kubernetes cluster from your local kubeconfig \u2014 live dashboards, logs, an in-pod shell, topology, Helm, Argo CD, a Security Center and one-click EKS/AKS onboarding.",
      "maintainer": "Praveen Kumar <praveensinghraghav96@gmail.com>",
      "vendor": "Praveen Kumar",
      "syncDesktopName": true,
      "artifactName": "${productName}-linux.${ext}",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-windows.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "shortcutName": "k8sight",
      "uninstallDisplayName": "k8sight"
    },
    "deb": {
      "fpm": [
        "--replaces",
        "k8s-manager-ui",
        "--conflicts",
        "k8s-manager-ui"
      ]
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "dist-helpers/**"
    ],
    "electronLanguages": [
      "en",
      "en-US"
    ]
  }
}
