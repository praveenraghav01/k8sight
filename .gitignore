# ------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------
node_modules/
client/node_modules/
.npm/
.pnp
.pnp.js

# ------------------------------------------------------------------
# Build output
# ------------------------------------------------------------------
dist/
build/dist/
client/dist/
*.tsbuildinfo

# Electron packaging output (installers, unpacked apps)
release/
out/

# Generated Electron icons are kept in the repo (CI needs them);
# only build/icon.svg is the source, icon.png / icon.icns are generated
# but intentionally committed — so nothing under build/ is ignored here.

# ------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Google OAuth client for GKE browser sign-in — generated at build time from
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET; never committed.
gke-oauth.json

# Never commit real kubeconfigs
kubeconfig
kubeconfig.*
*.kubeconfig

# ------------------------------------------------------------------
# Editor / OS cruft
# ------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------
# Test / coverage / caches
# ------------------------------------------------------------------
coverage/
.nyc_output/
.cache/
.vite/
*.tgz

# Fetched trivy binary (scripts/fetch-trivy.mjs) — not committed
/bin/

# Bundled token helpers (scripts/bundle-token-helpers.mjs) — generated per build
/dist-helpers/

# /brag skill video output — not part of the app
/brag-output/
